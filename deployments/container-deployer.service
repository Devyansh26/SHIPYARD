[Unit]
Description=ShipYard Container Deployer Service
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/shipyard/container_deploy
Environment=PYTHONUNBUFFERED=1
# Docker daemon may still be starting when the user manager boots; wait for it
# so the first job after a reboot does not fail on a dead docker socket.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 2; done; exit 0'
ExecStart=%h/shipyard/container_deploy/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8002 --workers 1 --log-level info
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
