# ============================================================================
# Redis — configure ONE of the two blocks below. Both reach the same Upstash
# database; TCP wins if you set both.
# ============================================================================

# (A) Upstash REST — the pair Upstash shows for serverless clients.
#     Console -> your database -> REST API.
UPSTASH_REDIS_REST_URL=https://your-db-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_long_rest_token

# (B) TCP — the `rediss://` string from the same console, under
#     "Connect to your database" -> redis-cli / Node / Python.
#     Preferred for a long-running server: one connection instead of an HTTP
#     round trip per job. ALSO the only option that supports blocking commands,
#     so the WORKER that consumes the queue almost certainly wants this one.
# REDIS_URL=rediss://default:your_password@your-db-12345.upstash.io:6379

# --- required ---------------------------------------------------------------
# Shared secret the control plane sends as X-Internal-Key (>= 16 chars).
# Must match CMS_INTERNAL_KEY in mern_backend/.env
INTERNAL_API_KEY=replace_with_a_long_random_string

# --- queues (defaults match what the worker consumes) -----------------------
DEPLOY_QUEUE_KEY=deployments:queue
DELETE_QUEUE_KEY=deletions:queue

# --- behaviour --------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
SUPERSEDE_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=21600

# --- optional: let CMS relay worker status back to the control plane --------
# Without these, a deployment row stays `queued` until something else reports
# its outcome. Leave unset if your worker calls the control plane directly.
# CONTROL_PLANE_URL=http://localhost:3001
# CONTROL_PLANE_KEY=same_as_INTERNAL_API_KEY_in_mern_backend
