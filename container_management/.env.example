APP_NAME=shipyard-container-management
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8001
HOST=0.0.0.0

# ---- Database: Neon PostgreSQL (asyncpg) ----------------------------------
# USE THE NEON *TEST* BRANCH. Never point development tooling at production.
# Direct endpoint:
#   postgresql://USER:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# Pooled endpoint: the host contains "-pooler" (PgBouncer, transaction mode).
#   CMS detects that automatically and disables asyncpg's statement cache,
#   which PgBouncer cannot support.
DATABASE_URL=postgresql://user:password@ep-example-000000.aws.neon.tech/neondb?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=5

# Apply migrations/*.sql at startup (idempotent, never drops anything).
# Prefer `python -m app.db.migrate` and keep this false in steady state.
RUN_MIGRATIONS=false

# ---- Docker Engine --------------------------------------------------------
# The socket is mounted at runtime by the deployment; it is never baked into
# the image.
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_DEFAULT_NETWORK=shipyard_network

# ---- Security (required: service fails fast at startup if unset) ----------
INTERNAL_API_KEY=change-me-in-production
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
