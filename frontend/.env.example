# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Where Vite's dev-server proxy forwards /api to. Read by vite.config.ts only.
BACKEND_URL=http://localhost:3001

# Leave VITE_BACKEND_URL UNSET for local development.
#
# Unset means "same origin": requests stay relative (/api/v1/...) and the proxy
# above handles them, so the browser sees one origin and the session cookie is
# first-party. That is what you want locally.

# ---------------------------------------------------------------------------
# Deployed builds (Vercel / Cloudflare Pages)
# ---------------------------------------------------------------------------
# There is no proxy in front of static hosting, so the browser must call the
# Control API directly. Set this to its public origin, with NO trailing path:
#
#   VITE_BACKEND_URL=https://your-api.example.com
#
# Only VITE_-prefixed variables reach the browser bundle, which is why this is
# a separate name from BACKEND_URL above. Read in exactly one place:
# src/lib/backend.ts
#
# Two things on the BACKEND must match, or requests arrive without a session
# and every authenticated call answers 401:
#
#   FRONTEND_URL=https://your-frontend.example.com   <- exact origin, for CORS
#   COOKIE_SAMESITE=none                             <- required cross-site;
#                                                       the backend then sets
#                                                       secure:true itself
