PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/shipyard?sslmode=require
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback
JWT_SECRET=replace_with_at_least_32_random_chars________
TOKEN_ENCRYPTION_KEY=64_hex_chars_32_bytes________________________________
COOKIE_SAMESITE=lax
# GitHub OAuth scopes requested: read:user repo

# --- Vercel (optional) -------------------------------------------------------
# Needed only for the one-click "Connect Vercel" OAuth button. Create an
# integration at https://vercel.com/dashboard/integrations/console and set its
# redirect URL to VERCEL_REDIRECT_URI below. Without these four vars users can
# still connect by pasting a Vercel access token
# (https://vercel.com/account/settings/tokens).
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
VERCEL_REDIRECT_URI=http://localhost:3001/api/v1/connections/vercel/callback
