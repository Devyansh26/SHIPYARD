APP_NAME=shipyard-container-deployer
LOG_LEVEL=INFO
PORT=8002
HOST=0.0.0.0

# Central PostgreSQL Database (Local or Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shipyard
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# Redis Queue
# Local: redis://localhost:6379/0
# Upstash (global queue, TLS): rediss://default:<TOKEN>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=deployments:queue
PROCESSING_SET=deployments:processing
# Idle BLPOP seconds per poll; raise (e.g. 25) on metered providers like Upstash
QUEUE_POLL_TIMEOUT_SECONDS=5

# Upstream Container Management Service
CONTAINER_MANAGEMENT_URL=http://localhost:8001
INTERNAL_API_KEY=dev_internal_secret_key_shipyard_2026

# Worker Execution Policy
MAX_JOB_RETRIES=3
JOB_TIMEOUT_SECONDS=600
HEALTHCHECK_TIMEOUT_SECONDS=60
WORKSPACE_DIR=/tmp/shipyard-workspaces

# Public deploy routing (Traefik labels + Cloudflare wildcard)
# Deploy URLs: shipyard-<service>-<id>.<DEPLOY_DOMAIN>
DEPLOY_DOMAIN=divy13ansh.in
DEPLOY_SUBDOMAIN_PREFIX=shipyard
cloudflare_api_token=your_cloudflare_api_token